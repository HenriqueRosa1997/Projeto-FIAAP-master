rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isProfessor() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'teacher' ||
        exists(/databases/$(database)/documents/professores/$(request.auth.uid))
      );
    }

    match /postagens/{postagemId} {
      allow read: if true;
      allow create, update, delete: if isProfessor();
    }

    match /alunos/{alunoId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /professores/{professorId} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == professorId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
